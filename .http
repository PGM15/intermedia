@baseUrl = http://localhost:3000
@accessToken = PEGA_AQUI_ACCESS_TOKEN
@refreshToken = PEGA_AQUI_REFRESH_TOKEN
@verificationCode = PEGA_AQUI_CODIGO_EMAIL
@clientId = PEGA_AQUI_CLIENT_ID
@projectId = PEGA_AQUI_PROJECT_ID
@deliveryNoteId = PEGA_AQUI_DELIVERYNOTE_ID

### Health
GET {{baseUrl}}/health

### Swagger
GET {{baseUrl}}/api-docs

### Register
POST {{baseUrl}}/api/user/register
Content-Type: application/json

{
  "email": "demo@test.com",
  "password": "12345678"
}

### Validate user
PUT {{baseUrl}}/api/user/validation
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "code": "{{verificationCode}}"
}

### Login
POST {{baseUrl}}/api/user/login
Content-Type: application/json

{
  "email": "demo@test.com",
  "password": "12345678"
}

### Complete profile
PUT {{baseUrl}}/api/user/register
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Pablo",
  "lastName": "Gonzalez",
  "nif": "12345678Z",
  "address": {
    "street": "Calle Mayor 12",
    "city": "Madrid",
    "postalCode": "28001",
    "country": "Espana"
  }
}

### Create or join company
PATCH {{baseUrl}}/api/user/company
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isFreelance": false,
  "name": "Mi Empresa SL",
  "cif": "B12345678",
  "address": {
    "street": "Gran Via 20",
    "city": "Madrid",
    "postalCode": "28013",
    "country": "Espana"
  }
}

### Get me
GET {{baseUrl}}/api/user
Authorization: Bearer {{accessToken}}

### Upload company logo
### Cambia ./logo.png por una imagen local de logo
PATCH {{baseUrl}}/api/user/logo
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< ./logo.png
--WebAppBoundary--

### Refresh token
POST {{baseUrl}}/api/user/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Create client
POST {{baseUrl}}/api/client
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Construcciones Garcia SL",
  "cif": "B87654321",
  "email": "cliente@garcia.com",
  "phone": "600123123",
  "address": {
    "street": "Calle Mayor",
    "number": "12",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### List clients with pagination/filter
GET {{baseUrl}}/api/client?page=1&limit=10&name=garcia&sort=-createdAt
Authorization: Bearer {{accessToken}}

### Get client
GET {{baseUrl}}/api/client/{{clientId}}
Authorization: Bearer {{accessToken}}

### Update client
PUT {{baseUrl}}/api/client/{{clientId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "phone": "611222333"
}

### Archive client
DELETE {{baseUrl}}/api/client/{{clientId}}?soft=true
Authorization: Bearer {{accessToken}}

### List archived clients
GET {{baseUrl}}/api/client/archived
Authorization: Bearer {{accessToken}}

### Restore client
PATCH {{baseUrl}}/api/client/{{clientId}}/restore
Authorization: Bearer {{accessToken}}

### Create project
POST {{baseUrl}}/api/project
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Reforma Oficina Central",
  "projectCode": "REF-001",
  "client": "{{clientId}}",
  "email": "obra@cliente.com",
  "notes": "Proyecto prioritario",
  "address": {
    "street": "Calle Obra",
    "number": "4",
    "postal": "28002",
    "city": "Madrid",
    "province": "Madrid"
  }
}

### List projects with filters
GET {{baseUrl}}/api/project?page=1&limit=10&client={{clientId}}&active=true&sort=-createdAt
Authorization: Bearer {{accessToken}}

### Get project
GET {{baseUrl}}/api/project/{{projectId}}
Authorization: Bearer {{accessToken}}

### Update project
PUT {{baseUrl}}/api/project/{{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "notes": "Notas actualizadas",
  "active": true
}

### Archive project
DELETE {{baseUrl}}/api/project/{{projectId}}?soft=true
Authorization: Bearer {{accessToken}}

### List archived projects
GET {{baseUrl}}/api/project/archived
Authorization: Bearer {{accessToken}}

### Restore project
PATCH {{baseUrl}}/api/project/{{projectId}}/restore
Authorization: Bearer {{accessToken}}

### Create material delivery note
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "client": "{{clientId}}",
  "project": "{{projectId}}",
  "format": "material",
  "description": "Entrega de materiales",
  "workDate": "2026-04-13",
  "material": "Cemento",
  "quantity": 25,
  "unit": "sacos"
}

### Create hours delivery note
POST {{baseUrl}}/api/deliverynote
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "client": "{{clientId}}",
  "project": "{{projectId}}",
  "format": "hours",
  "description": "Trabajo realizado",
  "workDate": "2026-04-14",
  "hours": 8,
  "workers": [
    { "name": "Ana", "hours": 4 },
    { "name": "Luis", "hours": 4 }
  ]
}

### List delivery notes with filters
GET {{baseUrl}}/api/deliverynote?page=1&limit=10&project={{projectId}}&client={{clientId}}&format=hours&signed=false&from=2026-01-01&to=2026-12-31&sort=-workDate
Authorization: Bearer {{accessToken}}

### Get delivery note
GET {{baseUrl}}/api/deliverynote/{{deliveryNoteId}}
Authorization: Bearer {{accessToken}}

### Download or get PDF URL
GET {{baseUrl}}/api/deliverynote/pdf/{{deliveryNoteId}}
Authorization: Bearer {{accessToken}}

### Sign delivery note
### Cambia ./signature.png por una imagen local de firma
PATCH {{baseUrl}}/api/deliverynote/{{deliveryNoteId}}/sign
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="signature"; filename="signature.png"
Content-Type: image/png

< ./signature.png
--WebAppBoundary--

### Delete unsigned delivery note
DELETE {{baseUrl}}/api/deliverynote/{{deliveryNoteId}}
Authorization: Bearer {{accessToken}}

### Logout
POST {{baseUrl}}/api/user/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
